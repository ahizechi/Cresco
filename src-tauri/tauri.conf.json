{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cresco",
  "version": "0.1.1",
  "identifier": "app.cresco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1462",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cresco",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1462 ws://127.0.0.1:1462; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ahizechi/Cresco/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMTExQzUyQTU1N0FBQTMKUldTanFsZWxVaHdSbzZWaGVlZ3h1Y2dRcjdwRnZGZnpHOVpHcnluLzhFOEhsQ0pNemdZdUN3OUgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Cresco",
    "shortDescription": "Your habits. Your money.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/fonts/Geist-OFL.txt": "Geist-OFL.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
